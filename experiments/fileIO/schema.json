[
  {
    "namespace": "fileIO",
    "functions": [
      {
        "name": "exists",
        "type": "function",
        "description": "Check if a file or directory exists",
        "async": true,
        "parameters": [
          {
            "name": "path",
            "type": "string",
            "description": "Absolute path to check"
          }
        ]
      },
      {
        "name": "readUTF8",
        "type": "function",
        "description": "Read file content as UTF-8",
        "async": true,
        "parameters": [
          {
            "name": "path",
            "type": "string",
            "description": "Absolute path to file"
          }
        ]
      },
      {
        "name": "writeUTF8",
        "type": "function",
        "description": "Write UTF-8 content to file (atomic, creates parent directories)",
        "async": true,
        "parameters": [
          {
            "name": "path",
            "type": "string",
            "description": "Absolute path to file"
          },
          {
            "name": "content",
            "type": "string",
            "description": "Content to write"
          }
        ]
      },
      {
        "name": "stat",
        "type": "function",
        "description": "Get file information",
        "async": true,
        "parameters": [
          {
            "name": "path",
            "type": "string",
            "description": "Absolute path to file"
          }
        ]
      },
      {
        "name": "listDir",
        "type": "function",
        "description": "List the full paths of a directory's direct children (empty array if the directory does not exist)",
        "async": true,
        "parameters": [
          {
            "name": "path",
            "type": "string",
            "description": "Absolute path to directory"
          }
        ]
      },
      {
        "name": "remove",
        "type": "function",
        "description": "Delete a file (missing files are treated as already-deleted)",
        "async": true,
        "parameters": [
          {
            "name": "path",
            "type": "string",
            "description": "Absolute path to file"
          }
        ]
      }
    ]
  }
]
