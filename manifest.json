{
  "manifest_version": 3,
  "name": "TB-TaXync",
  "version": "2.1.3",
  "description": "Sync Thunderbird tags/keywords across multiple installations via Syncthing or SMB",
  "author": "Jens",

  "browser_specific_settings": {
    "gecko": {
      "id": "{d1e8e8a5-8f5c-4b8a-9e7c-1a2b3c4d5e6f}",
      "strict_min_version": "128.0"
    }
  },

  "experiment_apis": {
    "fileIO": {
      "schema": "experiments/fileIO/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["fileIO"]],
        "script": "experiments/fileIO/parent.js"
      }
    }
  },

  "background": {
    "scripts": [
      "backends/backend-adapter.js",
      "backends/storage-backend.js",
      "backends/filesystem-backend.js",
      "sync/path-discovery.js",
      "sync/error-handler.js",
      "sync/tag-manager.js",
      "sync/sync-engine.js",
      "background.js"
    ]
  },

  "permissions": [
    "messagesRead",
    "accountsRead",
    "storage",
    "messagesTagsList",
    "messagesTags"
  ],

  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "TB-TaXync",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  }
}
